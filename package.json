{
  "name": "ai-skills",
  "displayName": "AI Skills",
  "description": "Discover and integrate AI Skills to supercharge your productivity. Search, install, and manage AI-powered tools and extensions directly from the Skills Marketplace within Visual Studio Code.",
  "version": "1.0.0",
  "publisher": "NecatiARSLAN",
  "repository": {
    "type": "git",
    "url": "https://github.com/necatiarslan/skills-vscode-extension"
  },
  "icon": "media/skills-logo-extension.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "skills",
    "productivity"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "Skills.Refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "Skills.Donate",
        "title": "Donate",
        "icon": "$(heart)"
      },
      {
        "command": "Skills.BugAndNewFeatureRequest",
        "title": "Bug and New Feature Request",
        "icon": "$(bug)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "Skills.Refresh",
          "when": "view == SkillsView",
          "group": "navigation"
        },
        {
          "command": "Skills.Donate",
          "when": "view == SkillsView",
          "group": "other_1"
        },
        {
          "command": "Skills.BugAndNewFeatureRequest",
          "when": "view == SkillsView",
          "group": "other_1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "Skills",
          "title": "AI Skills",
          "icon": "media/skills-logo-activitybar.png"
        }
      ]
    },
    "views": {
      "Skills": [
        {
          "id": "SkillsView",
          "name": "",
          "type": "webview",
          "icon": "media/skills-logo-activitybar.png"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "SkillsView",
        "contents": "Search and discover AI Skills from the marketplace. Start typing in the search box to explore available tools and extensions."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.8.0",
    "@types/vscode": "^1.120.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.3.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "^0.0.45",
    "markdown-it": "^14.1.1",
    "reflect-metadata": "^0.2.2"
  },
  "overrides": {
    "mocha": {
      "diff": "8.0.3",
      "glob": {
        "minimatch": "9.0.9"
      },
      "minimatch": "9.0.9",
      "serialize-javascript": "7.0.4"
    }
  }
}
