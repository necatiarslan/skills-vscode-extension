{
  "name": "skills",
  "displayName": "Skills",
  "description": "A customizable developer dock for files, notes, scripts, and VS Code commands",
  "version": "1.0.0",
  "publisher": "NecatiARSLAN",
  "repository": {
    "type": "git",
    "url": "https://github.com/necatiarslan/skills-vscode-extension"
  },
  "icon": "media/skills-logo-extension.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "developer",
    "productivity",
    "notes",
    "scripts",
    "files",
    "commands"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "Skills.Add",
        "title": "Add",
        "icon": "$(add)"
      },
      {
        "command": "Skills.Remove",
        "title": "Remove",
        "icon": "$(trash)"
      },
      {
        "command": "Skills.Refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "Skills.Filter",
        "title": "Filter",
        "icon": "$(filter)"
      },
      {
        "command": "Skills.ShowOnlyFavorite",
        "title": "Show Only Favorite",
        "icon": "$(bookmark)"
      },
      {
        "command": "Skills.ShowHidden",
        "title": "Show Hidden",
        "icon": "$(eye-closed)"
      },
      {
        "command": "Skills.Hide",
        "title": "Hide"
      },
      {
        "command": "Skills.UnHide",
        "title": "UnHide"
      },
      {
        "command": "Skills.AddFav",
        "title": "Fav",
        "icon": "$(star)"
      },
      {
        "command": "Skills.RemoveFav",
        "title": "UnFav",
        "icon": "$(star-empty)"
      },
      {
        "command": "Skills.ShowOnlyInThisWorkspace",
        "title": "Show Only In This Workspace"
      },
      {
        "command": "Skills.ShowInAnyWorkspace",
        "title": "Show In Any Workspace"
      },
      {
        "command": "Skills.NodeAdd",
        "title": "Add",
        "icon": "$(add)"
      },
      {
        "command": "Skills.NodeRemove",
        "title": "Remove",
        "icon": "$(trash)"
      },
      {
        "command": "Skills.NodeRefresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "Skills.NodeView",
        "title": "View",
        "icon": "$(eye)"
      },
      {
        "command": "Skills.NodeEdit",
        "title": "Edit",
        "icon": "$(pencil)"
      },
      {
        "command": "Skills.NodeRun",
        "title": "Run",
        "icon": "$(play)"
      },
      {
        "command": "Skills.NodeStop",
        "title": "Stop",
        "icon": "$(stop)"
      },
      {
        "command": "Skills.NodeOpen",
        "title": "Open",
        "icon": "$(go-to-file)"
      },
      {
        "command": "Skills.NodeInfo",
        "title": "Info",
        "icon": "$(info)"
      },
      {
        "command": "Skills.NodeCopy",
        "title": "Copy",
        "icon": "$(copy)"
      },
      {
        "command": "Skills.NodeAlias",
        "title": "Alias",
        "icon": "$(case-sensitive)"
      },
      {
        "command": "Skills.SetTooltip",
        "title": "Set Tooltip",
        "icon": "$(comment)"
      },
      {
        "command": "Skills.SetColor",
        "title": "Set Color",
        "icon": "$(symbol-color)"
      },
      {
        "command": "Skills.MoveUp",
        "title": "Move Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "Skills.MoveDown",
        "title": "Move Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "Skills.MoveToFolder",
        "title": "Move to Folder",
        "icon": "$(folder)"
      },
      {
        "command": "Skills.Donate",
        "title": "Donate",
        "icon": "$(heart)"
      },
      {
        "command": "Skills.BugAndNewFeatureRequest",
        "title": "Bug and New Feature Request",
        "icon": "$(bug)"
      },
      {
        "command": "Skills.ExportConfig",
        "title": "Export Config",
        "icon": "$(arrow-down)"
      },
      {
        "command": "Skills.ImportConfig",
        "title": "Import Config",
        "icon": "$(arrow-up)"
      },
      {
        "command": "Skills.OpenMarketplace",
        "title": "Open Skills Marketplace",
        "icon": "$(extensions)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "Skills.Donate",
          "when": "view == SkillsView",
          "group": "other_2"
        },
        {
          "command": "Skills.BugAndNewFeatureRequest",
          "when": "view == SkillsView",
          "group": "other_2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "Skills",
          "title": "Skills",
          "icon": "media/skills-logo-activitybar.png"
        }
      ]
    },
    "views": {
      "Skills": [
        {
          "id": "SkillsView",
          "name": "", 
          "type": "webview",
          "icon": "media/skills-logo-activitybar.png"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "SkillsView",
        "contents": "Search and discover AI Skills from the marketplace. Start typing in the search box to explore available tools and extensions."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/glob": "^9.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@types/tmp": "^0.2.6",
    "@types/vscode": "^1.106.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.1.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/uuid": "^11.0.0",
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "^0.0.45",
    "archiver": "^7.0.1",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "^4.1.1",
    "reflect-metadata": "^0.2.2",
    "tmp": "^0.2.5",
    "uuid": "^13.0.0",
    "yauzl": "^3.2.1"
  },
  "overrides": {
    "archiver": {
      "readdir-glob": "3.0.0"
    },
    "archiver-utils": {
      "glob": {
        "minimatch": "9.0.9"
      }
    },
    "mocha": {
      "diff": "8.0.3",
      "glob": {
        "minimatch": "9.0.9"
      },
      "minimatch": "9.0.9",
      "serialize-javascript": "7.0.4"
    }
  }
}
