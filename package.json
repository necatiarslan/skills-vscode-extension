{
  "name": "ai-agent-skills",
  "displayName": "AI Agent Skills",
  "description": "Discover and Install AI Agent Skills to enhance your AI agents' capabilities. Browse the Skills Marketplace, inspect skill details, and manage your installed skills directly from the sidebar.",
  "version": "1.0.3",
  "publisher": "NecatiARSLAN",
  "repository": {
    "type": "git",
    "url": "https://github.com/necatiarslan/skills-vscode-extension"
  },
  "icon": "media/skills-logo-extension.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "skills",
    "productivity"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "Skills.Refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "Skills.Donate",
        "title": "Donate",
        "icon": "$(heart)"
      },
      {
        "command": "Skills.BugAndNewFeatureRequest",
        "title": "Bug and New Feature Request",
        "icon": "$(bug)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "Skills.Refresh",
          "when": "view == SkillsView",
          "group": "navigation"
        },
        {
          "command": "Skills.Donate",
          "when": "view == SkillsView",
          "group": "other_1"
        },
        {
          "command": "Skills.BugAndNewFeatureRequest",
          "when": "view == SkillsView",
          "group": "other_1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "Skills",
          "title": "AI Agent Skills",
          "icon": "media/skills-logo-activitybar.png"
        }
      ]
    },
    "views": {
      "Skills": [
        {
          "id": "SkillsView",
          "name": "",
          "type": "webview",
          "icon": "media/skills-logo-activitybar.png"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "SkillsView",
        "contents": "Search and discover AI Agent Skills from the marketplace. Start typing in the search box to explore available tools and extensions."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.106.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "^0.0.45",
    "markdown-it": "^14.2.0",
    "reflect-metadata": "^0.2.2"
  }
}
